# /etc/fstab — qwertoo en el fierro (UEFI, sin /boot separado)
# <fs>          <mountpoint>  <type>  <opts>             <dump> <pass>
LABEL=root      /             ext4    defaults,noatime  0 1
LABEL=EFI       /efi          vfat    umask=0077        0 2
LABEL=swap      none          swap    sw                0 0

